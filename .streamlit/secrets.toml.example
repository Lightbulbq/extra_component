[auth]
# option to require auth login or not
require_auth = false

# auth cookie config
cookie_name = "qsviz-cookie"
cookie_key = "qsviz-cookie-key"
cookie_expiry = 30

[connections.authdb]
spreadsheet = ""

# auth cache ttl (in secs)- determines how frequently to fetch authenticated user list from google sheet
ttl = 3600

[connections.flagged_words]
spreadsheet = ""

[connections.gsheets]
# From your JSON key file
type = "service_account"
project_id = ""
private_key_id = ""
private_key = ""
client_email = ""
client_id = ""
auth_uri = ""
token_uri = ""
auth_provider_x509_cert_url = ""
client_x509_cert_url = ""


